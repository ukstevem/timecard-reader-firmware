// Copy this file to `arduino_secrets.h` and fill in real values.
// arduino_secrets.h is gitignored — never commit credentials.
//
// These are BUILD-TIME defaults baked into the firmware. At runtime
// /timecard/config.ini on the SD card overrides them per-device, so
// these only matter if the reader boots without a configured SD card.

#define SECRET_WIFI_SSID  ""
#define SECRET_WIFI_PASS  ""

#define SECRET_MQTT_USER  ""
#define SECRET_MQTT_PASS  ""
